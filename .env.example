# Copy to .env. DATA, MODEL and EFFORT are required; OUTPUT defaults to output, PROVIDER to claude.
DATA=data           # folder of survey PDFs (gitignored; an absolute path is fine)
OUTPUT=output       # folder for pipeline results (relative to the project, or absolute)
PROVIDER=claude     # what reads the pages: claude (Claude Code 2.1.280+) or codex (OpenAI's Codex CLI)
MODEL=claude-opus-5-5  # transcription model: claude-* / sonnet / opus / haiku, or gpt-* with PROVIDER=codex
EFFORT=low          # its reasoning effort
