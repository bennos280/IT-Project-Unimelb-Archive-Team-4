# Copy to .env. DATA, MODEL and EFFORT are required; OUTPUT defaults to output.
DATA=data           # folder of survey PDFs (gitignored; an absolute path is fine)
OUTPUT=output       # folder for pipeline results (relative to the project, or absolute)
MODEL=claude-opus-5-5  # transcription model (needs Claude Code 2.1.280+): claude-* / sonnet / opus / haiku, or gpt-* via codex
EFFORT=low          # its reasoning effort
