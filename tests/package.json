{
  "name": "survey-ui-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm --prefix ../frontend run lint",
    "build": "npm --prefix ../frontend run build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "uv run --with httpx2 python integration/frontend/check_review_integration.py",
    "test:all": "npm run lint && npm run build && npm run test:unit && npm run test:e2e && npm run test:integration",
    "test:page-actions": "playwright test page-actions.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "vitest": "^5.0.3"
  }
}
